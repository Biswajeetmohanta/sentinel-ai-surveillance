# Application Settings
PROJECT_NAME="Sentinel AI Surveillance Platform"
API_V1_STR="/api/v1"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Database Settings (PostgreSQL or local SQLite for testing)
DATABASE_URL="sqlite+aiosqlite:///./sentinel.db"
# For Production PostgreSQL with PostGIS:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/sentinel_db"

# Redis Cache Settings
REDIS_URL="redis://localhost:6379/0"
USE_REDIS_CACHE=False

# MediaMTX Streaming Server Settings
MEDIAMTX_API_URL="http://localhost:8554"
MEDIAMTX_RTSP_BASE="rtsp://localhost:8554"

# AI Inference Settings
AI_CONFIDENCE_THRESHOLD=0.75
YOLO_MODEL_PATH="yolov8n.pt"
ENABLE_MOCK_STREAM_SIMULATION=True
SNAPSHOT_STORAGE_PATH="./uploads/snapshots"
